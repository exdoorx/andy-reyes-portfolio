# Copy this file to ".env" and fill in your values.
# Restart `npm run dev` after editing.
#
# Production form handling (recommended): Cloudflare Worker
#   1. Deploy cloudflare/worker.js with `wrangler deploy`.
#   2. Put the Worker URL here.
# VITE_CONTACT_ENDPOINT=https://andy-portfolio-contact.YOUR-ACCOUNT.workers.dev
#
# Optional fallback: direct Supabase insert (the anon key is safe because the
# database/schema.sql enables Row Level Security).
# VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
#
# If none of the variables above are configured, the contact form opens the
# visitor's email client instead of sending to a database.

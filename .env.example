# TEMPLATE ONLY — copy to .env and replace every REPLACEME value.
# VITE_* variables are embedded in the public JS bundle; only the anon
# (publishable) key may live here. Never put the service_role key in a VITE_* var.

# --- Supabase (public, safe for the browser) ---
VITE_SUPABASE_URL=REPLACEME-https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACEME-your-supabase-anon-key

# --- Contact delivery (optional) ---
# 1) Cloudflare Worker (recommended): set this to the deployed Worker URL.
#    Form posts go there; the admin dashboard reads inquiries from it too.
# 2) Unset: falls back to a direct Supabase REST insert (protected by RLS).
# 3) If neither this nor correct Supabase vars exist, the form uses mailto.
VITE_CONTACT_ENDPOINT=REPLACEME-https://andy-portfolio-contact.YOUR-ACCOUNT.workers.dev

# --- Server-side only (Cloudflare Worker secrets, NOT here) ---
# Set with `wrangler secret put ...`: SUPABASE_SERVICE_KEY, ADMIN_USER_IDS,
# optional TURNSTILE_SECRET_KEY. Supabase URL for the worker goes in
# cloudflare/wrangler.toml [vars].
